# =============================================================================
# OPNsense Fleet Manager Enterprise - environment template
#
# Copy to `.env` and change every value marked CHANGE_ME before any deployment.
# The compose file reads this file for the API, worker and beat containers.
# =============================================================================

# --------------------------------------------------------------------- platform
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | testing | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_DOCS=true
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
TRUSTED_PROXY_IPS=

# --------------------------------------------------------------------- rate limiting
# Fixed-window budgets per identity (credential, device id or client IP).
# Authentication endpoints use RATE_LIMIT_AUTH_REQUESTS instead.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------------------------------------------------- security
# REQUIRED - at least 64 random characters in production
#   openssl rand -hex 48
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ENABLE_MFA=true
MFA_ISSUER=OFME
API_KEY_PREFIX=ofme

# --------------------------------------------------------------------- database
POSTGRES_USER=ofme
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=ofme
POSTGRES_PORT=5432
# Consumed by the application (async driver)
DATABASE_URL=postgresql+asyncpg://ofme:CHANGE_ME_pg_password@postgres:5432/ofme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --------------------------------------------------------------------- redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# --------------------------------------------------------------------- storage
MINIO_ROOT_USER=ofme-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ofme-minio
S3_SECRET_KEY=CHANGE_ME_minio_password
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_BACKUPS=ofme-backups
S3_BUCKET_ARTIFACTS=ofme-artifacts
# Optional server-side encryption for uploaded objects. Leave empty for MinIO
# without KMS; use AES256 (or aws:kms + S3_KMS_KEY_ID) on AWS S3.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# --------------------------------------------------------------------- PKI
PKI_CA_CERT_PATH=/etc/ofme/pki/ca.crt
PKI_CA_KEY_PATH=/etc/ofme/pki/ca.key
PKI_DEVICE_VALIDITY_DAYS=365
PKI_RENEW_BEFORE_DAYS=30
PKI_KEY_SIZE=3072
ENROLLMENT_TOKEN_TTL_MINUTES=60

# --------------------------------------------------------------------- LDAP / AD
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_USE_TLS=true
# "cn=ofme-admins,ou=groups,dc=example,dc=com=TenantAdmin;cn=ofme-auditors,...=Auditor"
LDAP_ROLE_MAP=

# --------------------------------------------------------------------- OIDC / Entra ID
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
OIDC_SCOPES=openid profile email groups
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --------------------------------------------------------------------- Vault
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret

# --------------------------------------------------------------------- Git providers
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=
GIT_WORK_DIR=/tmp/ofme-git
GIT_COMMIT_AUTHOR=OFME Automation <automation@ofme.local>

# --------------------------------------------------------------------- behaviour
HEARTBEAT_INTERVAL_SECONDS=60
DEVICE_OFFLINE_AFTER_SECONDS=180
METRIC_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=2555
WEBHOOK_TIMEOUT_SECONDS=15
OPNsense_TIMEOUT_SECONDS=20
OPNsense_VERIFY_TLS=true
DEFAULT_TENANT_SLUG=default
BOOTSTRAP_ADMIN_EMAIL=admin@ofme.example.com
# Leave empty to skip first-boot admin creation.
BOOTSTRAP_ADMIN_PASSWORD=

# --------------------------------------------------------------------- grpc
# Internal read-only inventory API (ofme.fleet.v1.FleetRegistry).
# Leave disabled unless an automation client needs it; when enabled, a token is
# mandatory and the port should stay on a private network or behind mTLS.
GRPC_ENABLED=false
GRPC_BIND=0.0.0.0:50051
GRPC_SERVICE_TOKEN=
GRPC_TLS_CERT_PATH=
GRPC_TLS_KEY_PATH=
GRPC_PORT=50051

# --------------------------------------------------------------------- observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=ofme-api
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# --------------------------------------------------------------------- containers
OFME_IMAGE_TAG=1.0.0
WAIT_FOR_DB=true
RUN_MIGRATIONS=true
API_PORT=8000
FRONTEND_PORT=8080
# Browser-facing API base URL; empty means "same origin" (nginx proxy).
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# --------------------------------------------------------------------- test agent
# One-time enrollment token for the ofme-test-agent container
# (tests/agent/). Mint a fresh one with `make ztp-token` and never commit it.
# The container lives in the "testing" Compose profile, so the default
# `docker compose up -d --wait` never waits on it; start it with `make agent-up`.
ENROLLMENT_TOKEN=
TEST_AGENT_SERIAL=OFME-TEST-001
